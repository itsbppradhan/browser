#!/bin/sh
set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    update-alternatives --install /usr/bin/x-www-browser \
        x-www-browser "/opt/Biraja Browser/biraja-browser" 80
    chown root "/opt/Biraja Browser/chrome-sandbox"
    chmod 4755 "/opt/Biraja Browser/chrome-sandbox"
    echo "Run sudo xdg-settings set default-web-browser biraja-browser.desktop && sudo update-alternatives --config x-www-browser to set Biraja Browser as your default browser."
    ln -sf "/opt/Biraja Browser/biraja-browser" /usr/bin/biraja-browser
fi
